# FaceSense AI Backend Environment Variables
APP_NAME="FaceSense AI"
APP_ENV="development"
PORT=8000
HOST="0.0.0.0"

# Database Configuration (SQLite default, PostgreSQL ready)
DATABASE_URL="sqlite:///./facesense.db"
# DATABASE_URL="postgresql://user:password@localhost:5432/facesense"

# Storage Configuration
STORAGE_DIR="./storage"
SNAPSHOT_DIR="./storage/snapshots"

# Security & CORS
SECRET_KEY="facesense-super-secret-key-change-in-production"
ALLOWED_ORIGINS="http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173"

# AI & Computer Vision Defaults
MIN_DETECTION_CONFIDENCE=0.5
MIN_TRACKING_CONFIDENCE=0.5
DEFAULT_ANALYSIS_INTERVAL_MS=150
DEFAULT_SAVE_HISTORY=true
DEFAULT_RETENTION_DAYS=30

